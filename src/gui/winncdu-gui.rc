#include <winver.h>
#include <winuser.h>

1 24 "winncdu-gui.manifest"
1 ICON "../../res/winncdu.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinNCDU - disk usage analyzer"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "winncdu"
            VALUE "OriginalFilename", "winncdu.exe"
            VALUE "ProductName", "WinNCDU"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
